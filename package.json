{
  "name": "cronductor",
  "version": "1.0.0",
  "description": "Distributed cron scheduler for Node.js using Redis-backed locking.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs'); for (const dir of ['dist','dist-tests']) fs.rmSync(dir,{recursive:true,force:true});\"",
    "clean:dist": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});\"",
    "clean:tests": "node -e \"require('node:fs').rmSync('dist-tests',{recursive:true,force:true});\"",
    "build": "npm run clean:dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run clean:tests && tsc -p tsconfig.test.json && node --test dist-tests/tests/*.test.js",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "keywords": [
    "cron",
    "scheduler",
    "distributed",
    "distributed-lock",
    "redis",
    "nodejs",
    "typescript",
    "job-scheduler"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xEbrahim/CronRun.git"
  },
  "bugs": {
    "url": "https://github.com/0xEbrahim/CronRun/issues"
  },
  "homepage": "https://github.com/0xEbrahim/CronRun#readme",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.7.2"
  }
}
