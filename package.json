{
  "name": "distributed-cron-lock",
  "version": "0.1.0",
  "description": "Distributed Redis locks for coordinating scheduled Node.js jobs across replicas.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-tests/tests/*.test.js"
  },
  "keywords": [
    "cron",
    "distributed-lock",
    "redis",
    "scheduler",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.17"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.7.2"
  }
}
